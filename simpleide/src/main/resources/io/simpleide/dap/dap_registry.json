{
  "adapters": [
    {
      "id": "js-debug",
      "name": "JavaScript Debug Adapter",
      "version": "1.140.1",
      "command": "node",
      "transport": "tcp",
      "launch": {
        "type": "node",
        "console": "internalConsole"
      },
      "arguments": [
        "${installDir}/js-debug/src/dapDebugServer.js",
        "${port}"
      ],
      "downloads": [
        { "os": "linux", "arch": "x86", "url": "https://github.com/microsoft/vscode-js-debug/releases/download/v1.140.1/js-debug-dap-v1.140.1-linux-x86.tar.gz", "archiveType": "tar.gz" },
        { "os": "linux", "arch": "x64", "url": "https://github.com/microsoft/vscode-js-debug/releases/download/v1.140.1/js-debug-dap-v1.140.1-linux-x64.tar.gz", "archiveType": "tar.gz" },
        { "os": "linux", "arch": "arm64", "url": "https://github.com/microsoft/vscode-js-debug/releases/download/v1.140.1/js-debug-dap-v1.140.1-linux-arm64.tar.gz", "archiveType": "tar.gz" },
        { "os": "windows", "arch": "x86", "url": "https://github.com/microsoft/vscode-js-debug/releases/download/v1.140.1/js-debug-dap-v1.140.1-win32-x86.zip", "archiveType": "zip" },
        { "os": "windows", "arch": "x64", "url": "https://github.com/microsoft/vscode-js-debug/releases/download/v1.140.1/js-debug-dap-v1.140.1-win32-x64.zip", "archiveType": "zip" },
        { "os": "windows", "arch": "arm64", "url": "https://github.com/microsoft/vscode-js-debug/releases/download/v1.140.1/js-debug-dap-v1.140.1-win32-arm64.zip", "archiveType": "zip" },
        { "os": "macos", "arch": "x64", "url": "https://github.com/microsoft/vscode-js-debug/releases/download/v1.140.1/js-debug-dap-v1.140.1-darwin-x64.tar.gz", "archiveType": "tar.gz" },
        { "os": "macos", "arch": "arm64", "url": "https://github.com/microsoft/vscode-js-debug/releases/download/v1.140.1/js-debug-dap-v1.140.1-darwin-arm64.tar.gz", "archiveType": "tar.gz" }
      ]
    },
    {
      "id": "debugpy",
      "name": "Python Debug Adapter",
      "version": "1.8.1",
      "command": "python",
      "transport": "stdio",
      "arguments": [
        "-m",
        "debugpy",
        "--listen",
        "127.0.0.1:${port}"
      ],
      "launch": {
        "program": "${program}"
      },
      "downloads": [
        { "os": "linux", "arch": "x86", "url": "https://github.com/microsoft/debugpy/releases/download/v1.8.1/debugpy-v1.8.1-linux-x86.tar.gz", "archiveType": "tar.gz" },
        { "os": "linux", "arch": "x64", "url": "https://github.com/microsoft/debugpy/releases/download/v1.8.1/debugpy-v1.8.1-linux-x64.tar.gz", "archiveType": "tar.gz" },
        { "os": "linux", "arch": "arm64", "url": "https://github.com/microsoft/debugpy/releases/download/v1.8.1/debugpy-v1.8.1-linux-arm64.tar.gz", "archiveType": "tar.gz" },
        { "os": "windows", "arch": "x86", "url": "https://github.com/microsoft/debugpy/releases/download/v1.8.1/debugpy-v1.8.1-win32-x86.zip", "archiveType": "zip" },
        { "os": "windows", "arch": "x64", "url": "https://github.com/microsoft/debugpy/releases/download/v1.8.1/debugpy-v1.8.1-win32-x64.zip", "archiveType": "zip" },
