<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE RSyntaxTheme SYSTEM "theme.dtd">
<RSyntaxTheme version="1.0">
  <background color="282A36"/>
  <caret color="F8F8F2"/>
  <selection useFG="false" bg="44475A" roundedEdges="false"/>
  <currentLineHighlight color="44475A" fade="false"/>
  <marginLine fg="44475A"/>
  <markAllHighlight color="44475A"/>
  <markOccurrencesHighlight color="44475A" border="false"/>
  <matchedBracket fg="FF79C6" bg="44475A" highlightBoth="true" animate="true"/>
